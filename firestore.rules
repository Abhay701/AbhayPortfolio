rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contactMessages/{messageId} {
      // Allow public creation of contact messages with strict validation
      allow create: if 
        // 1. Check required fields exist and have correct types
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3 &&
        request.resource.data.phone is string &&
        request.resource.data.countryCode is string &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() > 0 &&
        
        // 2. Validate the message field (optional, can be string or null)
        (
          !('message' in request.resource.data) || 
          request.resource.data.message == null || 
          request.resource.data.message is string
        ) &&
        
        // 3. System fields
        request.resource.data.status == 'unread' &&
        request.resource.data.createdAt == request.time &&
        
        // 4. Ensure no extra fields are injected
        request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'countryCode', 'subject', 'message', 'createdAt', 'status']);
      
      // 5. Restrict all other access (Read, Update, Delete)
      allow read, update, delete: if false;
    }
    
    // Default deny all
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
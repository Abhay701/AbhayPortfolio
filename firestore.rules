rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contactMessages/{messageId} {
      // Allow anyone to create a message if it follows the strict schema
      allow create: if 
        // Validate required fields and types
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
        request.resource.data.phone is string &&
        request.resource.data.countryCode is string &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() > 0 &&
        request.resource.data.status == 'unread' &&
        
        // Validate server timestamp
        request.resource.data.createdAt == request.time &&
        
        // Handle optional message field (can be string or null)
        (request.resource.data.message == null || request.resource.data.message is string) &&
        
        // Ensure no extra fields are added (Basic protection)
        request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'countryCode', 'subject', 'message', 'createdAt', 'status']);
      
      // Strict lockdown: No one can read, update, or delete via the client SDK
      allow read, update, delete: if false;
    }
    
    // Default deny for everything else
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
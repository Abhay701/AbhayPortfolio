
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contactMessages/{messageId} {
      // Allow anyone to create a message if it has the required fields
      allow create: if request.resource.data.name is string
                   && request.resource.data.email is string
                   && request.resource.data.phone is string
                   && request.resource.data.countryCode is string
                   && request.resource.data.subject is string
                   && request.resource.data.status == 'unread'
                   && request.resource.data.createdAt != null;
      
      // Reading, updating, and deleting are restricted to prevent public access
      allow read, update, delete: if false;
    }
  }
}
